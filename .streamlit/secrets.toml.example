# =============================================================================
# DATASET AUTOMATOR — Streamlit Community Cloud Secrets
# =============================================================================
# Copy this template to .streamlit/secrets.toml locally (NEVER commit the
# real secrets.toml). On Streamlit Cloud, paste these values directly in
# Settings → Secrets.
#
# Keys are automatically exposed as:
#   st.secrets["GEMINI_API_KEY"]
#   os.environ["GEMINI_API_KEY"]   (Streamlit mirrors secrets to env)
# =============================================================================

# ── 🔮 Primary LLM — Google AI Studio (Gemini) ────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY = "AIzaSy_YOUR_GEMINI_KEY_HERE"

# ── 🔄 Fallback LLM — OpenRouter (200+ models, pay-per-use) ──────────────
# Get your key at: https://openrouter.ai/settings/keys
# Provides access to: Claude 3.5, GPT-4o, Mistral, Llama 3.1, etc.
OPENROUTER_API_KEY = "sk-or-v1_YOUR_OPENROUTER_KEY_HERE"

# ── OpenRouter configuration (optional, defaults shown) ──────────────────
# Default model used when Gemini is unavailable
OPENROUTER_MODEL = "google/gemma-2-27b-it"
# Your app's public URL (required by OpenRouter HTTP-Referer header)
OPENROUTER_SITE_URL = "https://your-app.streamlit.app"
OPENROUTER_SITE_NAME = "Dataset Automator"
